        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=Bạn là biên tập viên YouTube Shorts cho EPCB. Chỉ dựa trên tên video và dữ liệu được cung cấp; không bịa thông số, tính năng hay khẳng định về hình ảnh/âm thanh không được mô tả. Tạo tiêu đề YouTube hấp dẫn, rõ ràng, tối đa 100 ký tự; mô tả ngắn tiếng Việt có lời mời xem/tương tác và hashtag phù hợp; thêm nội dung bài đăng ngắn. Chỉ trả về JSON hợp lệ duy nhất theo schema {\"youtubeTitle\":\"\",\"youtubeDescription\":\"\",\"youtube\":\"\"}, không markdown."
            },
            {
              "content": "={{ 'Tạo metadata và nội dung cho YouTube Short có tên: ' + $json.topic + '. Tên file gốc: ' + $json.fileName + '. Nội dung hình ảnh/lời thoại chưa được cung cấp, hãy tránh suy diễn.' }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "44c75200-4303-4e67-9d91-5e49a3f76eb5",
      "name": "AI tạo nội dung YouTube Short",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        496,
        1344
      ],
      "credentials": {
        "openAiApi": {
          "id": "9MHUX2e2dWl9LzNK",
          "name": "OpenAI account datvct"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ai = $json || {};\nconst texts = [];\n\nconst walk = (value, depth = 0) => {\n  if (depth > 8 || value == null) return;\n  if (typeof value === 'string') {\n    if (value.trim()) texts.push(value.trim());\n    return;\n  }\n  if (Array.isArray(value)) {\n    value.forEach((item) => walk(item, depth + 1));\n    return;\n  }\n  if (typeof value === 'object') {\n    Object.values(value).forEach((item) => walk(item, depth + 1));\n  }\n};\n\nwalk(ai);\nconst raw = texts.find((text) => text.includes('{')) || texts.sort((a, b) => b.length - a.length)[0] || '';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(raw);\n} catch {\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n  if (start >= 0 && end > start) {\n    try { parsed = JSON.parse(raw.slice(start, end + 1)); } catch {}\n  }\n}\n\nconst file = $json;\nconst youtubeTitle = String(parsed.youtubeTitle || '').trim().slice(0, 100);\nconst youtubeDescription = String(parsed.youtubeDescription || '').trim();\nconst youtubeContent = String(parsed.youtube || youtubeDescription).trim();\nif (!youtubeTitle || !youtubeDescription || !youtubeContent) {\n  throw new Error(`AI chưa tạo đủ nội dung cho file: ${file.name || file.id}`);\n}\n\nreturn {\n  json: {\n    sourceRowId: `google-drive-${String(file.id)}`,\n    employeeName: 'Google Drive',\n    originalNote: `Video Drive: ${String(file.name || '').trim()}`,\n    postType: 'youtube_short',\n    videoFileId: String(file.id),\n    videoFileName: String(file.name || 'video.mp4'),\n    youtubeTitle,\n    youtubeDescription,\n    youtubeContent,\n  },\n};"
      },
