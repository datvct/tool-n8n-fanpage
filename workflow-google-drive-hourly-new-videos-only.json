    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json }) => {\n  const fileName = String(json.name || json.fileName || '').trim();\n  const mimeType = String(json.mimeType || '').toLowerCase();\n  const supportedVideo = /\\.(mp4|mov|m4v|webm|avi)$/i.test(fileName);\n  const isVideo = mimeType.startsWith('video/') || supportedVideo;\n  const topic = fileName.replace(/\\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim();\n\n  return {\n    json: {\n      ...json,\n      isVideo,\n      topic,\n      fileId: json.id || json.fileId,\n      fileName,\n    },\n  };\n});"
      },
