      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\n// Header Auth của Webhook đã xác thực x-publish-key trước khi node này chạy.\nif (!body.postId || !body.scheduledAt || !body.platform || !String(body.content || '').trim()) {\n  throw new Error('Missing publish payload');\n}\n\nconst platform = String(body.platform).toLowerCase();\nif (!['facebook', 'linkedin'].includes(platform)) {\n  throw new Error('Unsupported platform');\n}\n\nconst cleanUrl = (value) => {\n  let url = String(value || '').trim();\n  const markdownMatch = url.match(/^\\[(.*?)\\]\\((.*?)\\)$/);\n  if (markdownMatch) url = markdownMatch[2];\n  return url.replace(/\\\\&/g, '&').replace(/&amp;/g, '&').trim();\n};\n\nconst media = (Array.isArray(body.media) ? body.media : [])\n  .map((item) => ({ ...item, url: cleanUrl(item?.url || item?.originalUrl) }))\n  .filter((item) => item.url);\n\nreturn [{\n  json: {\n    ...body,\n    postId: String(body.postId),\n    platform,\n    scheduledAt: new Date(body.scheduledAt).toISOString(),\n    media,\n    mediaUrls: media.map((item) => item.url),\n  },\n}];"
      },
