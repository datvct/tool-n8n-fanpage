generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  editor
  viewer
}

enum ContentStatus {
  pending
  generating
  draft
  approved
  rejected
  archived
}

enum Platform {
  facebook
  linkedin
  youtube
}

enum PostType {
  post
  facebook_reel
  youtube_short
  youtube_video
}

enum SocialPostStatus {
  draft
  approved
  scheduled
  publishing
  published
  failed
  cancelled
}

enum StorageType {
  google_drive
  s3
  minio
  cloudinary
}

model User {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  email     String            @unique
  role      UserRole          @default(viewer)
  versions  ContentVersion[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  @@map("users")
}

model ContentItem {
  id           String           @id @default(uuid()) @db.Uuid
  source       String
  sourceRowId  String           @map("source_row_id")
  employeeName String           @map("employee_name")
  originalNote String           @map("original_note") @db.Text
  status       ContentStatus    @default(pending)
  media        MediaAsset[]
  versions     ContentVersion[]
  socialPosts  SocialPost[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  @@unique([source, sourceRowId])
  @@index([sourceRowId])
  @@index([status])
  @@index([createdAt])
  @@map("content_items")
}

model MediaAsset {
  id          String      @id @default(uuid()) @db.Uuid
  contentId   String      @map("content_id") @db.Uuid
  fileName    String      @map("file_name")
  fileUrl     String      @map("file_url") @db.Text
  storageType StorageType @map("storage_type")
  mimeType    String?     @map("mime_type")
  sortOrder   Int         @default(0) @map("sort_order")
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now()) @map("created_at")
  @@index([contentId])
  @@map("media_assets")
}

model ContentVersion {
  id        String      @id @default(uuid()) @db.Uuid
  contentId String      @map("content_id") @db.Uuid
  platform  Platform
  content   String      @db.Text
  version   Int
  createdBy String?     @map("created_by") @db.Uuid
  item      ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  author    User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now()) @map("created_at")
  @@unique([contentId, platform, version])
  @@index([contentId])
  @@map("content_versions")
}

model SocialPost {
  id             String           @id @default(uuid()) @db.Uuid
  contentId      String           @map("content_id") @db.Uuid
  platform       Platform
  postType       PostType         @default(post) @map("post_type")
  content        String           @db.Text
  title          String?          @db.Text
  description    String?          @db.Text
  status         SocialPostStatus  @default(draft)
  scheduledAt    DateTime?        @map("scheduled_at")
  publishedAt    DateTime?        @map("published_at")
  externalPostId String?          @map("external_post_id")
  errorMessage   String?          @map("error_message") @db.Text
  retryCount     Int              @default(0) @map("retry_count")
  item           ContentItem      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  logs           PublishLog[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  @@index([status])
  @@index([platform])
  @@index([postType])
  @@index([scheduledAt])
  @@index([contentId])
  @@unique([contentId, platform])
  @@map("social_posts")
}

model PublishLog {
  id           String     @id @default(uuid()) @db.Uuid
  socialPostId String     @map("social_post_id") @db.Uuid
  platform     Platform
  status       String
  request      Json?      @map("request_payload")
  response     Json?      @map("response_payload")
  errorMessage String?    @map("error_message") @db.Text
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
  @@index([socialPostId])
  @@map("publish_logs")
}

model WebsiteProduct {
  id             String                @id @default(uuid()) @db.Uuid
  sourceUrl      String                @map("source_url") @db.Text
  canonicalUrl   String                @map("canonical_url") @db.Text
  productName    String                @map("product_name") @db.Text
  description    String                @db.Text
  specifications String?               @db.Text
  category       String?
  contentHash    String                @map("content_hash") @db.Text
  isActive       Boolean               @default(true) @map("is_active")
  crawledAt      DateTime              @default(now()) @map("crawled_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime?             @map("updated_at")
  images         WebsiteProductImage[]
  publications   WebsiteProductPublication[]

  @@index([canonicalUrl])
  @@index([contentHash])
  @@index([isActive])
  @@map("website_products")
}

model WebsiteProductImage {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  imageUrl  String        @map("image_url") @db.Text
  altText   String?       @map("alt_text") @db.Text
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  product   WebsiteProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("website_product_images")
}

model WebsiteProductPublication {
  id                String        @id @default(uuid()) @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  contentId         String?       @map("content_id") @db.Uuid
  status            String        @default("reserved")
  selectedImageUrl  String?       @map("selected_image_url") @db.Text
  selectedImageUrls Json?         @map("selected_image_urls")
  reservedAt        DateTime      @default(now()) @map("reserved_at")
  generatedAt       DateTime?     @map("generated_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  product           WebsiteProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId])
  @@index([status])
  @@map("website_product_publications")
}
