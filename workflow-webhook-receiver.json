    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body || $json;\nif (!body.postId) throw new Error('Missing postId');\nif (!body.scheduledAt) throw new Error('Missing scheduledAt');\nif (!['facebook', 'linkedin'].includes(String(body.platform))) throw new Error('Unsupported platform');\nif (!String(body.content || '').trim()) throw new Error('Missing content');\nconst scheduledAt = new Date(body.scheduledAt);\nif (Number.isNaN(scheduledAt.getTime())) throw new Error('Invalid scheduledAt');\nconst media = Array.isArray(body.media) ? body.media.filter((item) => item?.url) : [];\nreturn { json: { postId: String(body.postId), scheduledAt: scheduledAt.toISOString(), platform: body.platform, content: String(body.content), employee: String(body.employee || ''), note: String(body.note || ''), media, mediaUrls: media.map((item) => item.url) } };"
      },
      "id": "e14d16cb-0849-4c03-94ad-1ee2156402fb",
      "name": "Chuẩn hóa dữ liệu publish",
      "type": "n8n-nodes-base.code",
