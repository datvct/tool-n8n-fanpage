    {
      "parameters": {
        "jsCode": "const payload = $input.first()?.json || {};\nconst legacyRaw = payload.linkHinhAnh || payload.content?.linkHinhAnh || '';\nconst legacyUrls = String(legacyRaw).split(/[,\\n]+/).map((url) => url.trim()).filter(Boolean);\nconst media = Array.isArray(payload.media) && payload.media.length ? payload.media : legacyUrls.map((url) => ({ url }));\nconst uniqueMedia = [...new Map(media.filter((item) => item?.url).map((item) => [item.url, item])).values()];\nif (!uniqueMedia.length) return [{ json: { ...payload, image_url: '', image_index: -1, image_count: 0, images: [] } }];\nreturn uniqueMedia.map((image, index) => ({ json: { ...payload, image_url: image.url, image_index: index, image_count: uniqueMedia.length, images: uniqueMedia } }));"
      },
